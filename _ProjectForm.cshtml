@model ProjectForm
<div asp-validation-summary="ModelOnly" class="validation"></div>
<div class="form-group">
    <label asp-for="ProjeAdi"></label>
    <input asp-for="ProjeAdi" maxlength="250" />
    <span asp-validation-for="ProjeAdi"></span>
</div>
<div class="form-group">
    <label asp-for="ProjeAciklamasi"></label>
    <textarea asp-for="ProjeAciklamasi" rows="6"></textarea>
</div>
<div class="form-group">
    <label asp-for="ProjeDegeri"></label>
    <input asp-for="ProjeDegeri" type="number" step="0.01" min="0" />
    <span asp-validation-for="ProjeDegeri"></span>
</div>
<div class="form-group">
    <label>Fotoğraflar</label>
    <input type="file" name="fotograflar" accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" multiple />
    <small>En fazla 10 fotoğraf; fotoğraf başına en fazla 5 MB.</small>
</div>
